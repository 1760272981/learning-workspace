# Learning Workspace 环境变量示例
# 复制为 .env 后按需填写；仓库与提交中不含任何真实密钥。
#
# 本地网页与 MCP 共用的数据文件（可选）。
# 默认 local-data/lw-local-db.json；两个本地进程应使用同一绝对路径。
LW_LOCAL_DATA_FILE=
LOCAL_PORT=8787

# MCP 云端写入：个人令牌与完整函数入口都配置时才走云端。
# 本地壳不要填这两个值；令牌在网页「我的令牌」中创建，只显示一次。
LW_USER_TOKEN=
LW_API_BASE=

# 旧站（legacy 机制）写入：共享写密钥 + 旧站函数入口。
# 与 LW_USER_TOKEN 二选一；两者都配时个人令牌优先。密钥真值不进仓库与聊天。
LW_WRITE_KEY=
